    "onboarding.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private reel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只刷你自己的相册"
          }
        },
        "zh-Hant": {
