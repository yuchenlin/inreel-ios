            "state": "translated",
            "value": "あなただけのリール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 비공개 릴"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reel privado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre reel privé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein privates Reel"
          }
        },
        "pt-BR": {
