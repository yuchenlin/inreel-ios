    "onboarding.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up for next · Double tap to keep · Swipe left to set aside"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上滑下一条 · 双击留下 · 左滑待删"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上滑下一條 · 雙擊留下 · 左滑待刪"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上スワイプで次へ · ダブルタップで残す · 左スワイプで保留"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위로 스와이프해 다음 · 두 번 탭해 보관 · 왼쪽으로 스와이프해 보류"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza arriba para siguiente · Doble toque para guardar · Izquierda para apartar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers le haut pour suivant · Double touche pour garder · Gauche pour mettre de côté"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch wischen für weiter · Doppeltipp zum Behalten · Links zum Zurückstellen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima para o próximo · Toque duplo para manter · Esquerda para separar"
          }
        }
      }
    },
