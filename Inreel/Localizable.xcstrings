    "basket.emptyAll.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes all items from the basket. Photos stay in your library — nothing is deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将待删篮中的全部项目移出。照片仍留在相册里，不会删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將待刪籃中的全部項目移出。照片仍留在相簿裡，不會刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バスケット内のすべてを外します。写真はライブラリに残り、削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류함의 모든 항목을 제거합니다. 사진은 라이브러리에 그대로 있으며 삭제되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita todos los elementos de la cesta. Las fotos permanecen en tu biblioteca; no se elimina nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire tous les éléments du panier. Les photos restent dans votre photothèque — rien n’est supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Elemente aus dem Korb. Fotos bleiben in der Mediathek — nichts wird gelöscht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todos os itens da cesta. As fotos permanecem na biblioteca — nada é apagado."
          }
        }
      }
    },
