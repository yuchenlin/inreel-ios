    "gate.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel needs Photo Library access to show your own photos offline. Nothing is uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel 需要访问相册才能在本地随机回顾你的照片。照片不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel 需要存取相簿才能在本機隨機回顧你的照片。照片不會上傳。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreelはオフラインであなたの写真を表示するため、フォトライブラリへのアクセスが必要です。何もアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel은 오프라인으로 내 사진을 보려면 사진 라이브러리 접근이 필요합니다. 아무것도 업로드되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel necesita acceso a la fototeca para mostrar tus fotos sin conexión. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel a besoin d’accéder à la photothèque pour afficher vos photos hors ligne. Rien n’est envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
