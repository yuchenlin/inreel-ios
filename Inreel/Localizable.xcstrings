    "settings.resetSeen.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears local seen/cooldown history. Photos stay in your library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会清空本机已阅与冷却记录。相册里的照片不会被删。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會清空本機已閱與冷卻記錄。相簿裡的照片不會被刪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末上の閲覧・クールダウン履歴を消去します。ライブラリの写真は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 본 기록/쿨다운 이력을 지웁니다. 라이브러리의 사진은 그대로입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el historial local de vistos/enfriamiento. Las fotos permanecen en tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface l’historique local des vus/délais. Les photos restent dans votre photothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht lokale Gesehen-/Abkling-Historie. Fotos bleiben in der Mediathek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa o histórico local de vistos/intervalo. As fotos permanecem na biblioteca."
          }
        }
      }
    },
