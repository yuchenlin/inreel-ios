    "settings.about.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel keeps everything on this device. No accounts, no uploads, no ads, no analytics. We collect nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel 全部在本机完成。没有账号，没有上传，没有广告，没有分析。我们不收集任何数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel 全部在本機完成。沒有帳號，沒有上傳，沒有廣告，沒有分析。我們不收集任何資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreelはすべてこのデバイスで完結します。アカウント・アップロード・広告・分析はありません。データを収集しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel은 모두 이 기기에서 처리됩니다. 계정, 업로드, 광고, 분석 없음. 어떤 데이터도 수집하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel lo hace todo en este dispositivo. Sin cuentas, sin subidas, sin anuncios, sin analíticas. No recopilamos nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel reste entièrement sur cet appareil. Pas de compte, pas d’envoi, pas de pub, pas d’analyse. Nous ne collectons rien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inreel läuft nur auf diesem Gerät. Keine Accounts, Uploads, Werbung oder Analysen. Wir erfassen nichts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Inreel fica todo neste dispositivo. Sem contas, sem envios, sem anúncios, sem análises. Não coletamos nada."
          }
        }
      }
    },
