    "settings.showSize.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size is estimated from the library when known. Hidden if unknown — never shown as “freed space”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体积能估才显示；估不到就隐藏。不会写成「已释放空间」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體積能估才顯示；估不到就隱藏。不會寫成「已釋放空間」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが分かるときだけ表示し、不明なら非表示。「解放済み容量」とは書きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기를 알 수 있을 때만 표시하고, 모르면 숨깁니다. ‘확보된 공간’으로 쓰지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño se estima cuando se conoce. Se oculta si es desconocido — nunca como “espacio liberado”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille est estimée si connue. Masquée si inconnue — jamais comme « espace libéré »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe nur wenn bekannt; sonst ausgeblendet — nie als „freigegebener Speicher“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho é estimado quando conhecido. Oculto se desconhecido — nunca como “espaço liberado”."
          }
        }
      }
    },
