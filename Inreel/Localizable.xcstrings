    "settings.alwaysUnmuted.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping the speaker in the Feed changes this too, and it applies to every video until you change it again. Pressing a volume button turns sound on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在信息流里点喇叭按钮也会改这个设置，并对之后所有视频生效，直到你再次更改。按音量键会打开声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在資訊流裡點喇叭按鈕也會改這個設定，並對之後所有影片生效，直到你再次更改。按音量鍵會打開聲音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードのスピーカーボタンでもこの設定が切り替わり、次に変更するまですべてのビデオに適用されます。音量ボタンを押すと音声がオンになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드의 스피커 버튼을 눌러도 이 설정이 바뀌며, 다시 바꿀 때까지 모든 비디오에 적용됩니다. 볼륨 버튼을 누르면 소리가 켜집니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar el altavoz en el Feed también cambia este ajuste, y se aplica a todos los vídeos hasta que lo vuelvas a cambiar. Pulsar un botón de volumen activa el sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher le haut-parleur dans le Feed modifie aussi ce réglage, qui s’applique à toutes les vidéos jusqu’à ce que vous le changiez. Appuyer sur un bouton de volume active le son."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lautsprecher-Symbol im Feed ändert diese Einstellung ebenfalls; sie gilt für alle Videos, bis du sie wieder änderst. Eine Lautstärketaste schaltet den Ton ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar no alto-falante no Feed também muda este ajuste, e ele vale para todos os vídeos até você mudar de novo. Apertar um botão de volume ativa o som."
          }
        }
      }
    },
