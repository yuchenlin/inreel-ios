    "settings.cooldown.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you view something in the Feed, hide it for this long before it can show again. Changing this only affects items you see from now on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在信息流里刷过的内容，在这段时间内不会再出现。改这个选项只影响之后新刷到的，已经记下的不会改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在資訊流裡刷過的內容，在這段時間內不會再出現。改這個選項只影響之後新刷到的，已經記下的不會改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードで見た項目は、この期間が過ぎるまで再表示されません。変更はこれから見る項目だけに効きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드에서 본 항목은 이 기간 동안 다시 안 나옵니다. 변경은 앞으로 새로 보는 항목에만 적용됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras ver algo en el feed, se oculta durante este tiempo. El cambio solo afecta a lo que veas a partir de ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir vu un élément dans le fil, il est masqué pendant cette durée. Le changement ne s’applique qu’aux éléments vus ensuite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Ansehen im Feed bleibt ein Element so lange ausgeblendet. Die Änderung gilt nur für neu gesehene Elemente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de ver algo no feed, ele fica oculto por este tempo. A mudança só vale para o que você ver daqui pra frente."
          }
        }
      }
    },
