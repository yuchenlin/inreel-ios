    "settings.display.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date, time, location, camera, and albums come from PhotoKit / EXIF on device. Size is estimated when known — never shown as “freed space.” Location uses the system geocoder when available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期、时间、地点、设备和相册来自本机 PhotoKit / EXIF。体积能估才显示，不会写成「已释放空间」。地点在可用时用系统地理编码器解析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日期、時間、地點、設備和相簿來自本機 PhotoKit / EXIF。體積能估才顯示，不會寫成「已釋放空間」。地點在可用時用系統地理編碼器解析。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付・時刻・場所・機材・アルバムは端末上のPhotoKit / EXIFから取得します。サイズは分かるときだけ表示し、「解放済み容量」とは書きません。場所は可能なときシステムジオコーダで解決します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜, 시간, 위치, 기기, 앨범은 기기의 PhotoKit / EXIF에서 옵니다. 크기는 알 수 있을 때만 표시하며 ‘확보된 공간’으로 쓰지 않습니다. 위치는 가능하면 시스템 지오코더로 해석합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha, hora, ubicación, cámara y álbumes vienen de PhotoKit / EXIF en el dispositivo. El tamaño se estima cuando se conoce — nunca como “espacio liberado”. La ubicación usa el geocodificador del sistema si está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Date, heure, lieu, appareil et albums proviennent de PhotoKit / EXIF sur l’appareil. La taille est estimée si connue — jamais affichée comme « espace libéré ». Le lieu utilise le géocodeur système si disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum, Uhrzeit, Ort, Kamera und Alben stammen von PhotoKit / EXIF auf dem Gerät. Größe nur wenn bekannt — nie als „freigegebener Speicher“. Ort nutzt den System-Geocoder, wenn verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, hora, local, câmera e álbuns vêm do PhotoKit / EXIF no dispositivo. O tamanho é estimado quando conhecido — nunca como “espaço liberado”. O local usa o geocodificador do sistema quando disponível."
          }
        }
      }
    },
