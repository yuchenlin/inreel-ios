    "onboarding.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and videos never leave this iPhone. No account. No uploads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和视频不离开这台 iPhone。没有账号，没有上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和影片不離開這台 iPhone。沒有帳號，沒有上傳。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオはこのiPhoneから出ません。アカウントもアップロードもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 비디오는 이 iPhone을 떠나지 않습니다. 계정 없음. 업로드 없음."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y vídeos nunca salen de este iPhone. Sin cuenta. Sin subidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos et vidéos ne quittent jamais cet iPhone. Pas de compte. Pas d’envoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos verlassen dieses iPhone nie. Kein Account. Keine Uploads."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos e vídeos nunca saem deste iPhone. Sem conta. Sem envios."
          }
        }
      }
    },
    "onboarding.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Full Photo Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要「所有照片」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要「所有照片」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「すべての写真」が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘모든 사진’ 접근 필요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita acceso completo a fotos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès Complet aux photos requis"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voller Fotozugriff erforderlich"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de Acesso Total às fotos"
          }
        }
      }
    },
    "onboarding.page2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A random reel needs the whole library. If you pick Selected Photos, Inreel can only show those."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随机回顾必须能看见整座相册。选「部分照片」时，Inreel 只能刷你挑中的那些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨機回顧必須能看見整座相簿。選「部分照片」時，Inreel 只能刷你挑中的那些。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランダムな振り返りにはライブラリ全体が必要です。「選択した写真」だと、選んだものだけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무작위 다시 보려면 전체 라이브러리가 필요합니다. ‘선택한 사진’이면 Inreel은 고른 항목만 보여줍니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reel al azar necesita toda la biblioteca. Con Fotos seleccionadas, Inreel solo puede mostrar esas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reel aléatoire nécessite toute la photothèque. Avec Photos sélectionnées, Inreel ne peut afficher que celles-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein zufälliges Reel braucht die gesamte Mediathek. Bei „Ausgewählte Fotos“ zeigt Inreel nur diese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reel aleatório precisa da biblioteca inteira. Com Fotos Selecionadas, o Inreel só pode mostrar essas."
          }
        }
      }
    },
